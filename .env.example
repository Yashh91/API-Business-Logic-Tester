
# Example environment variables for API authentication.
# Replace placeholder values locally. Never commit real credentials.

# Generic bearer-token authentication
API_TOKEN=replace_with_your_test_token

# Generic API-key authentication
API_KEY=replace_with_your_test_api_key

# Example profile-specific bearer tokens
CINEMA_API_TOKEN=replace_with_your_cinema_test_token
ECOMMERCE_API_TOKEN=replace_with_your_ecommerce_test_token
HOTEL_API_TOKEN=replace_with_your_hotel_test_token
